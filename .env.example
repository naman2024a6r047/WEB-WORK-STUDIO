# ==============================================================================
# CENTRAL ERP COMMAND — ENVIRONMENT CONFIGURATION
# ==============================================================================

PORT=4000
NODE_ENV=production
JWT_SECRET=central-erp-super-secret-jwt-key-992182749

# ==============================================================================
# HOSTINGER DATABASE (MySQL / MariaDB) CONFIGURATION
# ==============================================================================
# In Hostinger hPanel:
# 1. Go to "Databases" -> Create a new MySQL database & user.
# 2. Go to "Remote MySQL" -> Add your IP or "%" (to allow connections from anywhere).
# 3. Fill in the credentials below:

DB_CLIENT=mysql
DB_HOST=sqlXXX.hostinger.com
DB_PORT=3306
DB_NAME=u123456789_central_erp
DB_USER=u123456789_admin
DB_PASSWORD=your_hostinger_database_password
DB_SSL=false

# ==============================================================================
# EMAIL (SMTP) NOTIFICATIONS CONFIGURATION
# ==============================================================================
# Hostinger Email / Titan / Gmail / SendGrid / Custom SMTP:
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=billing@yourdomain.com
SMTP_PASS=your_email_password
SMTP_FROM="Central ERP Command" <billing@yourdomain.com>
